# Host-side published ports
# VITE_APP_PORT=3000 # uncomment to change default
# POSTGRES_PORT=5432 # uncomment to change default
# VITE_APP_STORAGE_PORT=8080 # uncomment to change default
# VITE_APP_ROOM_PORT=5001 # uncomment to change default
# PROD_APP_PORT=5010 # uncomment to change default

# Host user the dev container runs as (files in the mounted source tree are owned by it).
# Set to the output of `id -u` / `id -g` if they differ from 1000.
# USER_UID=1000 # uncomment to change default
# USER_GID=1000 # uncomment to change default

# Postgres credentials
# POSTGRES_USER=excalidraw-user # uncomment to change default
POSTGRES_PASSWORD=
# POSTGRES_DB=excalidraw-dev # uncomment to change default
